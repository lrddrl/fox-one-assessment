# Copy to .env.local for local development with `vercel dev`.
# In production these are set in the Vercel project's Environment Variables.
# .env.local is gitignored — never commit a real key.

# Required: your MiniMax API key.
MINIMAX_API_KEY=

# Optional. MiniMax has separate hosts for its domestic and international
# platforms; set this to match the key above. Check your MiniMax console.
#   International (default): https://api.minimaxi.chat/v1
#   Domestic:               https://api.minimax.chat/v1
# MINIMAX_BASE_URL=https://api.minimaxi.chat/v1

# Optional. Model name — confirm the exact string in your MiniMax console.
# MINIMAX_MODEL=MiniMax-Text-01

# Optional. Only needed if your MiniMax account requires a GroupId.
# MINIMAX_GROUP_ID=
