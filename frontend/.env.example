# Copy to .env.local for local development with `vercel dev`.
# In production these are set in the Vercel project's Environment Variables.
# .env.local is gitignored — never commit a real key.

# Required: your MiniMax API key.
MINIMAX_API_KEY=

# Optional. MiniMax's Anthropic-compatible base URL. Override only if you point
# this at a different Anthropic-Messages-compatible provider.
# MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic

# Optional. Model id — confirm the exact string in your MiniMax console.
# MINIMAX_MODEL=MiniMax-M3
